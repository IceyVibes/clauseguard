{
  "manifest_version": 3,
  "name": "ClauseGuard",
  "version": "1.2.0",
  "description": "Educational prototype: click Scan to check a site's Terms/Privacy Policy against a pre-built demo cache, locally. Not legal advice.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClauseGuard"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:5500/*",
    "http://localhost:5500/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5500/*",
        "http://localhost:5500/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
